# Copy to .env.local for local work. Nothing here is required to run the site: without
# DATABASE_URL every page renders from the checked-in seeds and /desk stays read-only.

# The origin that actually serves this build. Drives canonical tags, og:url, sitemap URLs,
# robots.txt and every JSON-LD @id. Never point a preview deployment at production's value.
NEXT_PUBLIC_SITE_URL=https://thruwallet.vercel.app

# Google Search Console -> Settings -> Ownership verification -> HTML tag.
# Paste the token (the `content` value), not the whole <meta> tag. It is public by design.
# Setting it emits <meta name="google-site-verification"> and answers /google<token>.html.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools -> Verify -> Meta tag. Optional.
BING_SITE_VERIFICATION=

# Optional: Postgres for the desk (field notes, smoke marks, sessions).
# DATABASE_URL=postgres://user:password@host:5432/database

# Optional: gate for /desk writes. Absent means read-only.
# DESK_PASSWORD=
